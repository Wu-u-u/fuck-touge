{
  "manifest_version": 3,
  "name": "Fuck 头歌",
  "version": "2.8.2",
  "description": "头歌/智慧树学习辅助（MIT 开源）。头歌：粘贴/复制、自动下一关、主题与壁纸；智慧树：视频 1.25x、自动连播、课中弹题（需 debugger 真实点击）。仅本地运行，不上传数据。",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Fuck 头歌",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "permissions": [
    "scripting",
    "activeTab",
    "storage",
    "unlimitedStorage",
    "debugger"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*"
      ],
      "matches": [
        "*://*.educoder.net/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.educoder.net/*"
      ],
      "js": [
        "允许粘贴.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.educoder.net/*"
      ],
      "js": [
        "fonts.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.educoder.net/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.zhihuishu.com/*"
      ],
      "js": [
        "zhihuishu.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "host_permissions": [
    "*://*.educoder.net/*",
    "*://*.zhihuishu.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
